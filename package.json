{
  "name": "liquitask",
  "productName": "LiquiTask",
  "private": true,
  "version": "2.6.1",
  "description": "A premium Kanban task management desktop app with a stunning liquid glass aesthetic",
  "author": {
    "name": "LiquidTask",
    "email": "support@liquitask.com"
  },
  "type": "module",
  "scripts": {
    "dev": "npm run prepare:semantic-sidecar-stub && npm run build:agentd && node scripts/dev-autoport.mjs",
    "free-dev-port": "bash scripts/free-dev-port.sh",
    "dev:web": "vite",
    "build": "npm run build:semantic-sidecar && npm run build:agentd && tauri build",
    "build:mac": "npm run build:semantic-sidecar && npm run build:agentd && tauri build --target aarch64-apple-darwin",
    "build:semantic-sidecar": "python3 semantic_layer/build_sidecar.py",
    "build:agentd": "bash scripts/build-agentd-sidecar.sh",
    "prepare:semantic-sidecar-stub": "bash scripts/create-semantic-sidecar-stub.sh",
    "prepare:semantic-sidecar-stub:win": "powershell -ExecutionPolicy Bypass -File scripts/create-semantic-sidecar-stub.ps1",
    "build:web": "vite build",
    "tauri": "tauri",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:coverage": "vitest --coverage",
    "semantic:serve": "python3 -m semantic_layer --port 8765",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\""
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/generative-ai": "0.21.0",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-virtual": "^3.13.23",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-http": "^2",
    "@tauri-apps/plugin-notification": "^2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "9.0.1",
    "remark-gfm": "4.0.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260421.2",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^24.0.0",
    "postcss": "^8.4.47",
    "prettier": "^3.2.0",
    "sharp": "^0.34.5",
    "svgo": "^4.0.1",
    "tailwindcss": "^3.4.0",
    "typescript": "npm:@typescript/typescript6@6.0.0",
    "vite": "^7.3.1",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
