# Tauri (Rust) — source is tracked; build output and generated schemas are not.
# Cargo.lock is intentionally committed for reproducible application builds.
src-tauri/target/
crates/**/target/
src-tauri/gen/
src-tauri/binaries/semantic-layer-*
src-tauri/binaries/liquitask-agentd*
src-tauri/binaries/liquitask-cli*
src-tauri/binaries/liquitask-aarch64-*
src-tauri/.fastembed_cache/

# Vendored reference checkouts — not our source, kept locally for reference only.
vendor/

# liquitask-agentd (Go sidecar) — source is tracked; the compiled binary is not.
liquitask-agentd/liquitask-agentd

# Semantic layer PyInstaller build artifacts
semantic_layer/.build-venv*/
semantic_layer/.build-cache/
semantic_layer/build/
semantic_layer/dist/

